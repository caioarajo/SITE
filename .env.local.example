# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Painel do Supabase > Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Usada apenas em rotas de servidor/admin que precisam de acesso total
# (Project Settings > API > service_role). NUNCA exponha isso no cliente.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Número de WhatsApp usado nos links "Fale comigo" (formato internacional, sem espaços)
NEXT_PUBLIC_WHATSAPP_NUMBER=5592992662890
